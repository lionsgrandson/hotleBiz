# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase secret key. NEVER expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 32-byte base64 key used for AES-256-GCM PII encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=REPLACE_ME

# Random high-entropy secret used for deterministic HMAC matching.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MATCHING_SECRET=REPLACE_ME

# Used to hash IP/user-agent data in audit logs without retaining raw values.
AUDIT_HASH_SECRET=REPLACE_ME

# Canonical application URL, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional transactional email. If empty, invite/access links are still generated.
RESEND_API_KEY=
EMAIL_FROM=GuestAtlas <noreply@example.com>

# Comma-separated emails allowed to bootstrap platform-admin status with scripts/promote-admin.mjs
PLATFORM_ADMIN_EMAILS=

# Require TOTP MFA for all authenticated staff operations. Strongly recommended for production.
REQUIRE_MFA=true

# Deployment automation (optional but avoids repeated interactive login)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# Vercel Cron authenticates retention queue maintenance with this value.
CRON_SECRET=REPLACE_ME
