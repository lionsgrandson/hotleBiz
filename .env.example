# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase secret key. NEVER expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 32-byte base64 key used for AES-256-GCM PII encryption.
PII_ENCRYPTION_KEY=REPLACE_ME

# Random high-entropy secret used for deterministic HMAC matching.
MATCHING_SECRET=REPLACE_ME

# Used to hash IP/user-agent data in audit logs without retaining raw values.
AUDIT_HASH_SECRET=REPLACE_ME

# URL handling:
# For first deploy without a custom domain, configure.cmd uses the temporary value below and
# GUESTATLAS_URL_MODE=workers_dev_auto. GO-LIVE.cmd deploys once, captures the assigned
# https://guestatlas.<account-subdomain>.workers.dev URL, rewrites .env.local, rebuilds,
# validates, and deploys again with the real canonical URL.
NEXT_PUBLIC_APP_URL=https://guestatlas-bootstrap.invalid
GUESTATLAS_URL_MODE=workers_dev_auto

# Optional transactional email. If empty, invite/access links are still generated.
RESEND_API_KEY=
EMAIL_FROM=GuestAtlas <noreply@example.com>

# Comma-separated emails allowed to bootstrap platform-admin status.
PLATFORM_ADMIN_EMAILS=

# Require TOTP MFA for authenticated hotel operations.
REQUIRE_MFA=true

# Supabase deployment automation. Token is optional; otherwise the CLI prompts login.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Cloudflare deployment automation. Token/account are optional if Wrangler interactive login is used.
# Leave CLOUDFLARE_CUSTOM_DOMAIN blank for automatic workers.dev deployment.
# For a custom domain, set NEXT_PUBLIC_APP_URL=https://host.example.com,
# GUESTATLAS_URL_MODE=fixed, and CLOUDFLARE_CUSTOM_DOMAIN=host.example.com.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CUSTOM_DOMAIN=

# Cloudflare maintenance Worker authenticates its daily retention call with this value.
CRON_SECRET=REPLACE_ME
