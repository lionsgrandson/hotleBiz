  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vercel": "59.11.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
